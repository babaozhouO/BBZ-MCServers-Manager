        Private Sub ButtonCancle_Click(sender As Object, e As EventArgs)
            Dim num As Integer = MessageBox.Show("是否放弃保存设置并退出?", "提示", MessageBoxButtons.YesNo)
            If num = 6 Then
                日志窗口.添加日志("关闭Sftp服务器设置窗口", 5)
                Close()
            End If
        End Sub

        Private Sub ButtonSaveAndExit_Click(sender As Object, e As EventArgs)
            Dim num As Integer = MessageBox.Show("是否保存设置并退出?", "提示", MessageBoxButtons.YesNo)
            If num = 6 Then
                配置文件操作模块.写入Sftp配置(Conversions.ToString(1), Conversions.ToString(配置文件操作模块.Sftp1开关), Me.名称1.Text, Me.地址1.Text, Me.端口1.Text, Me.用户名1.Text, Me.密码1.Text)
                配置文件操作模块.写入Sftp配置(Conversions.ToString(2), Conversions.ToString(配置文件操作模块.Sftp2开关), Me.名称2.Text, Me.地址2.Text, Me.端口2.Text, Me.用户名2.Text, Me.密码2.Text)
                配置文件操作模块.写入Sftp配置(Conversions.ToString(3), Conversions.ToString(配置文件操作模块.Sftp3开关), Me.名称3.Text, Me.地址3.Text, Me.端口3.Text, Me.用户名3.Text, Me.密码3.Text)
                日志窗口.添加日志("成功保存Sftp服务器设置", 3)
                Call 日志窗口.日志输出SFTP配置()
                日志窗口.添加日志("", 7)
                日志窗口.添加日志("关闭Sftp服务器设置窗口", 5)
                Close()
            End If
        End Sub

        Private Sub SftpSettingsForm_Load(sender As Object, e As EventArgs)
            配置文件操作模块.读取Sftp配置()
            If 配置文件操作模块.Sftp1开关 Then
                开关控件1.切换状态()
            End If
            Me.Sftp1.Text = 配置文件操作模块.Sftp1名称
            Me.名称1.Text = 配置文件操作模块.Sftp1名称
            Me.地址1.Text = 配置文件操作模块.Sftp1地址
            Me.端口1.Text = 配置文件操作模块.Sftp1端口
            Me.用户名1.Text = 配置文件操作模块.Sftp1用户名
            Me.密码1.Text = 配置文件操作模块.Sftp1密码
            If 配置文件操作模块.Sftp2开关 Then
                开关控件2.切换状态()
            End If
            Me.Sftp2.Text = 配置文件操作模块.Sftp2名称
            Me.名称2.Text = 配置文件操作模块.Sftp2名称
            Me.地址2.Text = 配置文件操作模块.Sftp2地址
            Me.端口2.Text = 配置文件操作模块.Sftp2端口
            Me.用户名2.Text = 配置文件操作模块.Sftp2用户名
            Me.密码2.Text = 配置文件操作模块.Sftp2密码
            If 配置文件操作模块.Sftp3开关 Then
                开关控件3.切换状态()
            End If
            Me.Sftp3.Text = 配置文件操作模块.Sftp3名称
            Me.名称3.Text = 配置文件操作模块.Sftp3名称
            Me.地址3.Text = 配置文件操作模块.Sftp3地址
            Me.端口3.Text = 配置文件操作模块.Sftp3端口
            Me.用户名3.Text = 配置文件操作模块.Sftp3用户名
            Me.密码3.Text = 配置文件操作模块.Sftp3密码
        End Sub

